# Copy to /etc/likelion-typing/backend.env, replace placeholders, then chmod 600.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/likelion_typing?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<APP_DB_USER>
SPRING_DATASOURCE_PASSWORD=<STRONG_DB_PASSWORD>
ADMIN_PASSWORD_HASH=<BCRYPT_HASH>
ADMIN_TOKEN_SECRET=<32+_BYTE_RANDOM_SECRET>
ADMIN_TOKEN_TTL_SECONDS=28800
ALLOWED_ORIGINS=https://<FRONTEND_DOMAIN>
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
JAVA_OPTS=-XX:InitialRAMPercentage=20.0 -XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError
